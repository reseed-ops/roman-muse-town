{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "bun-types"
    ],
    "rootDir": "..",
    "tsBuildInfoFile": "./.tsbuildinfo.web",
    "paths": {
      "@hatch/space-sdk": [
        "./shim/spaceSdkServer.ts"
      ],
      "@hatch/space-sdk/client": [
        "./shim/spaceSdkClient.ts"
      ],
      "@space/privileged": [
        "../server/.generated/privileged.contract"
      ]
    }
  },
  "include": [
    "src/**/*",
    "shim/**/*",
    "*.ts"
  ]
}
